# Application Port (Auto-assigned by Cloud Platforms like Render/Railway)
PORT=3000

# ==============================================================================
# AI ENGINE CONFIGURATION
# ==============================================================================
# Option 1: Groq Cloud API (Recommended for Cloud Deployment - 100% Free & Fast)
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=

# Optional: Override Groq Model (Default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Option 2: Ollama Local or Remote Server (Used automatically if GROQ_API_KEY is blank)
# OLLAMA_HOST=http://localhost:11434
